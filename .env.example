# Copiar como .env. No guardar credenciales reales en este archivo.
PAYROLL_APP_NAME=Payroll Argentina
PAYROLL_ENVIRONMENT=development
PAYROLL_DEBUG=false
# Obligatorio con valor propio si PAYROLL_ENVIRONMENT no es 'development'
# (el arranque falla en ese caso con secreto vacio o 'change-me-in-production').
PAYROLL_SECRET_KEY=
PAYROLL_DATABASE_URL=sqlite:///./data/payroll.db
PAYROLL_WEB_DATA_SOURCE=demo
PAYROLL_WEB_AUTH_ENABLED=true
# En produccion la app fuerza cookie_secure=True aunque quede en false aqui;
# servir siempre por HTTPS (V2-11/PW-6).
PAYROLL_COOKIE_SECURE=false
# Origenes CORS permitidos, separados por coma (vacio = ninguno). Cada origen
# permitido es de plena confianza CSRF con cookies: solo abrirlo para un
# frontend propio por HTTPS; los POST de la API con cookie deben enviar el
# header X-CSRF-Token cuando haya origins configurados (V2-14).
#PAYROLL_CORS_ORIGINS=https://app.ejemplo.com
PAYROLL_SESSION_MAX_AGE=28800
PAYROLL_SEED_DEMO=false
PAYROLL_NORMATIVE_CCT_DIR=normative/cct

# Ajustar al UID/GID propietario de data/ en Linux.
PAYROLL_UID=1000
PAYROLL_GID=1000

# Solo para el perfil PostgreSQL (`docker compose --profile postgres ...`).
# Definir una contraseña no vacía antes de usarlo: el arranque falla si
# POSTGRES_PASSWORD está vacío con el perfil activo.
POSTGRES_DB=payroll
POSTGRES_USER=payroll
POSTGRES_PASSWORD=
# Ejemplo para apuntar la app a ese Postgres (reemplazar la URL sqlite de arriba):
# PAYROLL_DATABASE_URL=postgresql+psycopg://payroll:changeme@postgres:5432/payroll
